<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State (Darker Shade) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#2A3CAD"
                android:endColor="#7C7FCE" />
            <corners android:radius="200dp"/>
        </shape>
    </item>

    <!-- Default State (Lighter Shade with Gradient) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#C5DAF4"
                android:endColor="#0850F8" />
            <corners android:radius="250dp"/>
        </shape>
    </item>
</selector>
