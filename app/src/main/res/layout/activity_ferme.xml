<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardElevation="6dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/fermeTitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌾 Ferme de Karim"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@android:color/holo_green_dark" />

            <TextView
                android:id="@+id/fermeLocalisation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Marrakech" />

            <TextView
                android:id="@+id/fermeSol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱 Sol: Argileux" />

            <TextView
                android:id="@+id/fermeSuperficie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📏 3.2 ha" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnModifierFerme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✏️ Modifier"
                    android:backgroundTint="@android:color/holo_green_light" />

                <Button
                    android:id="@+id/btnSupprimerFerme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗑️ Supprimer"
                    android:backgroundTint="@android:color/holo_red_light"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnAjouterCulture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌾 Ajouter culture"
                    android:backgroundTint="@android:color/holo_green_dark"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/btnAjouterAnimal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐄 Ajouter animal"
                    android:backgroundTint="@android:color/holo_orange_light"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>