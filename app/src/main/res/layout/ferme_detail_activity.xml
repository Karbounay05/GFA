<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#6627E4DA">

    <FrameLayout
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:background="@drawable/slide_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <!-- Titre -->
                <TextView
                    android:id="@+id/titreFermes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Détails de la ferme"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#4C4D4C"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="serif"
                    android:layout_marginBottom="24dp"/>

                <!-- Sous-titre Animaux -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Animaux"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="#000000"
                    android:layout_marginBottom="8dp" />

                <!-- RecyclerView Animaux -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewAnimaux"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Sous-titre Cultures -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cultures"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="#000000"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>

                <!-- RecyclerView Cultures -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewCultures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Boutons Ajouter -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="32dp">

                    <Button
                        android:id="@+id/btnAjouterAnimal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button_background"
                        android:backgroundTint="@color/black"
                        android:text="Ajouter Animal"
                        android:textColor="@android:color/white"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnAjouterCulture"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/button_background"
                        android:backgroundTint="@color/black"
                        android:text="Ajouter Culture"
                        android:textColor="@android:color/white"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
