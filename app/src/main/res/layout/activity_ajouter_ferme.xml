<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A71EA162">

    <FrameLayout
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:background="@drawable/slide_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="83dp"
                android:layout_height="99dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/addferme" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajouter une nouvelle ferme"
                android:textColor="#1EA162"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/editNomF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nom de la ferme"
                android:layout_marginTop="24dp" />

            <SeekBar
                android:id="@+id/seekBarSuperficie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="10"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/textSuperficieValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 hectares"
                android:textColor="#000000"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/editLocalisation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Localisation"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/spinnerTypeSol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnAjouterFerme"
                android:layout_width="172dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:background="@drawable/button_background"
                android:text="Ajouter la ferme" />
        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
