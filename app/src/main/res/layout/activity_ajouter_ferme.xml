<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A71EA162">

    <FrameLayout
        android:layout_width="340dp"
        android:layout_height="551dp"
        android:background="@drawable/slide_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/editNomF"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:layout_marginLeft="15dp"
            android:hint="Nom de la ferme" />

        <EditText
            android:id="@+id/editSuperficie"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="150dp"
            android:hint="Superficie (hectares)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/editLocalisation"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="220dp"
            android:layout_marginLeft="15dp"
            android:hint="Localisation" />

        <EditText
            android:id="@+id/editTypeSol"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="290dp"
            android:hint="Type de sol" />

        <Button
            android:id="@+id/btnAjouterFerme"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="125dp"
            android:layout_marginTop="485dp"

            android:background="@drawable/button_background"
            android:text="Ajouter la ferme" />
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
