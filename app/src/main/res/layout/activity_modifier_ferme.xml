<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A71EA162">

    <FrameLayout
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:background="@drawable/slide_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Image en haut -->
            <ImageView
                android:id="@+id/imageViewModifierFerme"
                android:layout_width="83dp"
                android:layout_height="99dp"
                app:srcCompat="@drawable/addferme"
                android:layout_gravity="center" />

            <!-- Titre -->
            <TextView
                android:id="@+id/titreModifier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modifier la Ferme"
                android:textColor="#1EA162"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                android:layout_gravity="center" />

            <!-- Nom ferme -->
            <EditText
                android:id="@+id/editNomF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nom de la ferme"
                android:layout_marginTop="24dp" />

            <!-- Superficie (SeekBar) -->
            <SeekBar
                android:id="@+id/seekBarSuperficie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="10"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/textSuperficieValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 hectares"
                android:textColor="#000000"
                android:layout_marginTop="8dp" />

            <!-- Localisation -->
            <EditText
                android:id="@+id/editLocalisation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Localisation"
                android:layout_marginTop="16dp" />

            <!-- Type de sol (Spinner) -->
            <Spinner
                android:id="@+id/spinnerTypeSol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <!-- Bouton Modifier -->
            <Button
                android:id="@+id/btnModifierFerme"
                android:layout_width="172dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:background="@drawable/button_background"
                android:text="Modifier"
                android:textColor="@android:color/white"
                android:backgroundTint="#1EA162" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
