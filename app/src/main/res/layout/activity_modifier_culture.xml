<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#009688">

    <FrameLayout
        android:layout_width="324dp"
        android:layout_height="wrap_content"
        android:background="@drawable/slide_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="338dp"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <!-- Image -->
                <ImageView
                    android:id="@+id/imageViewModifierCulture"
                    android:layout_width="83dp"
                    android:layout_height="99dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/culture" />

                <!-- Titre -->
                <TextView
                    android:id="@+id/textViewTitleModifierCulture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modifier une culture"
                    android:textColor="#009688"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <!-- Surface (EditText) -->
                <TextView
                    android:id="@+id/textSurface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Surface : 0 m²"
                    android:textColor="#000000"
                    android:layout_marginTop="16dp" />

                <SeekBar
                    android:id="@+id/seekBarSurface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="10000"
                    android:layout_marginTop="8dp" />

                <Spinner
                    android:id="@+id/spinnerSaison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" />

                <LinearLayout
                    android:layout_width="200dp"
                    android:layout_height="160dp"
                    android:layout_marginLeft="-40dp"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="État de la plante :"
                        android:textColor="#000000"
                        android:layout_marginTop="24dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <CheckBox
                            android:id="@+id/checkboxBonneSante"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bonne santé" />

                        <CheckBox
                            android:id="@+id/checkboxMaladie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maladie" />

                        <CheckBox
                            android:id="@+id/checkboxSeche"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Séchage" />
                    </LinearLayout>


                </LinearLayout>

                <Button
                    android:id="@+id/btnModifierCulture"
                    android:layout_width="172dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="32dp"
                    android:text="Modifier Culture"
                    android:background="@drawable/button_background"
                    android:backgroundTint="#009688"
                    android:textColor="@android:color/white" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
