<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A71EA162"
    android:padding="24dp"
    tools:context=".VerificationActivity">

    <!-- Container Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:background="@drawable/slide_background">

            <!-- Top Icon -->
            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/gmail"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:contentDescription="Gmail Icon" />

            <!-- Title -->
            <TextView
                android:id="@+id/verifyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code de vérification"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1EA162"
                app:layout_constraintTop_toBottomOf="@id/imageView2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp" />

            <!-- Input Field -->
            <EditText
                android:id="@+id/codeInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Entrez le code reçu par email"
                android:inputType="number"
                android:padding="12dp"
                android:backgroundTint="#1EA162"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/verifyTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="24dp" />

            <!-- Verify Button -->
            <Button
                android:id="@+id/verifyBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vérifier"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:background="@drawable/button_background"
                app:layout_constraintTop_toBottomOf="@id/codeInput"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="32dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
