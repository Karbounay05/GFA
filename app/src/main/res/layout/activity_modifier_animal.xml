<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#009688">

    <FrameLayout
        android:layout_width="324dp"
        android:layout_height="550dp"
        android:background="@drawable/slide_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/imageViewModifierAnimal"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:src="@drawable/livestock" />

                <TextView
                    android:id="@+id/textViewModifierTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Modifier l'animal"
                    android:textColor="#009688"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Nombre -->
                <TextView
                    android:id="@+id/textNombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Nombre : 0"
                    android:textColor="#000000" />

                <SeekBar
                    android:id="@+id/seekBarNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100" />

                <!-- Statut Sanitaire -->
                <LinearLayout
                    android:layout_width="200dp"
                    android:layout_height="160dp"
                    android:layout_marginLeft="-40dp"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Statut Sanitaire :"
                        android:textColor="#000000" />

                    <CheckBox
                        android:id="@+id/checkboxBonneSante"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Bonne Santé" />

                    <CheckBox
                        android:id="@+id/checkboxMaladie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maladie" />

                    <CheckBox
                        android:id="@+id/checkboxAutre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Autre" />


                </LinearLayout>
                <Button
                    android:id="@+id/btnModifierAnimal"
                    android:layout_width="172dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/button_background"
                    android:backgroundTint="#009688"
                    android:text="Modifier l'animal"
                    android:textColor="@android:color/white" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
