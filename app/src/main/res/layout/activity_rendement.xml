<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Categorie Spinner -->
        <TextView
            android:text="Catégorie"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Spinner
            android:id="@+id/spinnerCategorie"
            android:background="@drawable/bg_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Superficie SeekBar -->
        <TextView
            android:id="@+id/labelSuperficie"
            android:text="Superficie : 0 ha"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/seekBarSuperficie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progressTint="#4CAF50"
            android:thumbTint="#4CAF50"
            android:layout_marginBottom="16dp" />

        <!-- Production -->
        <EditText
            android:id="@+id/inputProduction"
            android:hint="Production (kg ou tonnes)"
            android:background="@drawable/bg_input"
            android:inputType="numberDecimal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Pertes -->
        <EditText
            android:id="@+id/inputPertes"
            android:hint="Pertes"
            android:background="@drawable/bg_input"
            android:inputType="numberDecimal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Date picker -->
        <TextView
            android:id="@+id/textDateChoisie"
            android:text="Sélectionner une date"
            android:textSize="16sp"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Calculate -->
        <Button
            android:id="@+id/btnEnvoyerRendement"
            android:text="Calculer"
            android:textAllCaps="false"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <!-- Results -->
        <TextView
            android:id="@+id/textRendementParHa"
            android:text="Rendement par hectare : -"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/textPertesParHa"
            android:text="Pertes par hectare : -"
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- View rendements -->
        <Button
            android:id="@+id/btnVoirRendements"
            android:text="Voir mes rendements"
            android:textAllCaps="false"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF" />
        <include
            layout="@layout/ping_card"
            android:id="@+id/pingCard"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
